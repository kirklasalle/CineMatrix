{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "cors_origins": ["*"],
    "domain_independent": true
  },
  "frontend": {
    "dist_dir": "frontend/dist",
    "base_path": "/"
  },
  "storage": {
    "database_url": "sqlite:///./backend/storyboard.db",
    "vector_store_path": "./backend/vector_store"
  },
  "deployment": {
    "mode": "standalone_host",
    "notes": "Ready for direct IP / VPS / PaaS hosting without requiring a custom domain."
  }
}
