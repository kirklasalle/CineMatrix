# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
ENV/
env/
*.env

# Database (never commit — may contain API keys)
*.db
*.db-shm
*.db-wal

# Vector store
backend/vector_store/

# Frontend dependencies and build
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs — keep directory tracked, ignore log file contents
logs/*.log
logs/*.log.*
!logs/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp

# Media generation output caches
backend/static/videos/*.mp4
backend/static/audio/*.wav
logs/*.json
!backend/static/videos/.gitkeep
!backend/static/audio/.gitkeep
